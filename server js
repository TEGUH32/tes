                        <button class="btn" onclick="viewVictim('${v.id}')">View Details</button>
                        <button class="btn btn-danger" onclick="deleteVictim('${v.id}')">Delete</button>
                    </div>
                `).join('')}
            </div>
        </div>
        
        <script>
            function viewVictim(id) {
                window.open('/victim/' + id, '_blank');
            }
            
            function deleteVictim(id) {
                if (confirm('Delete this victim?')) {
                    fetch('/victim/' + id, { method: 'DELETE' })
                        .then(() => location.reload());
                }
            }
        </script>
    </body>
    </html>
    `;
    
    res.send(dashboard);
});

